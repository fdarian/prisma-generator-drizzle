{
	"compilerOptions": {
		"target": "ES2018",
		"module": "commonjs",
		"lib": ["esnext"],
		"types": ["node"],
		"strict": true,
		"strictPropertyInitialization": false,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"removeComments": true,
		"sourceMap": true,
		"moduleResolution": "bundler",
		"outDir": "./dist",
		"rootDir": "./src",
		"newLine": "lf",
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["**/node_modules", "**/*.test.ts"]
}
