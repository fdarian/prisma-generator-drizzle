{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"lib": ["esnext"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"paths": {
			"~/tests/*": ["./tests/*"],
			"src/*": ["./src/*"],
			"prisma/*": ["./prisma/*"]
		},
		"moduleResolution": "bundler",
		"types": ["vitest/globals"]
	}
}
