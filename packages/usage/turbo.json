{
	"$schema": "https://turbo.build/schema.json",
	"extends": ["//"],
	"tasks": {
		"generate": {},
		"pushreset:postgres": {
			"cache": false,
			"dependsOn": ["^build"],
			"env": ["VITE_PG_DATABASE_URL"]
		},
		"pushreset:mysql": {
			"cache": false,
			"dependsOn": ["clone:mysql", "^build"],
			"env": ["VITE_MYSQL_DATABASE_URL"]
		},
		"pushreset:sqlite": {
			"cache": false,
			"dependsOn": ["clone:sqlite", "^build"]
		},
		"test": {
			"cache": false,
			"env": ["VITE_PG_DATABASE_URL", "VITE_MYSQL_DATABASE_URL"],
			"dependsOn": [
				"^build",
				"pushreset:postgres",
				"pushreset:mysql",
				"pushreset:sqlite"
			]
		},
		"clone:sqlite": {
			"inputs": ["prisma/schema.prisma"]
		},
		"clone:mysql": {
			"inputs": ["prisma/schema.prisma"]
		},
		"clone": {
			"dependsOn": ["clone:sqlite", "clone:mysql"]
		}
	}
}
