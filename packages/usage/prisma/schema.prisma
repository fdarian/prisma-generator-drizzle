generator drizzle {
  provider = "bunx prisma-generator-drizzle"
}

datasource db {
  provider = "postgresql"
}

model SelfReference {
  id String @id

  referringManyId String?
  referringMany   SelfReference?  @relation("SelfReference_referringMany", fields: [referringManyId], references: [id])
  referredMany    SelfReference[] @relation("SelfReference_referringMany")

  referringUniqueId String?        @unique
  referringUnique   SelfReference? @relation("SelfReference_referringUnique", fields: [referringUniqueId], references: [id])
  referredUnique    SelfReference? @relation("SelfReference_referringUnique")
}

// #region Implicit relationship purposes

model TransactionHeader {
  id       String          @id
  products ProductDetail[]
}

model ProductDetail {
  id           String              @id
  transactions TransactionHeader[]
}

// With custom table name
model Post {
  id         String     @id
  categories Category[] @relation("CustomCategoryToPost")
}

model Category {
  id    String @id
  posts Post[] @relation("CustomCategoryToPost")
}

// With @@map where the mapped table name order is the reverse of the model name order
model MappedArticle {
  id   String      @id
  tags MappedTag[]

  @@map("z_articles")
}

model MappedTag {
  id       String          @id
  articles MappedArticle[]

  @@map("a_tags")
}

// Join table columns take the type of the ids they reference
model IntAuthor {
  id    Int       @id
  books IntBook[]
}

model IntBook {
  id      Int         @id
  authors IntAuthor[]
}

// Self relation, `following` is declared first to show that Prisma assigns side A by field name order, not declaration order
model Person {
  id        Int      @id
  following Person[] @relation("Follows")
  followers Person[] @relation("Follows")
}

// Two self relations on the same model
model Account {
  id        Int       @id
  blocked   Account[] @relation("Blocks")
  blockedBy Account[] @relation("Blocks")
  muted     Account[] @relation("Mutes")
  mutedBy   Account[] @relation("Mutes")
}

// Multiple relations between the same pair of models
model Author {
  id    String @id
  liked Book[] @relation("Likes")
  saved Book[] @relation("Saves")
}

model Book {
  id      String   @id
  likedBy Author[] @relation("Likes")
  savedBy Author[] @relation("Saves")
}

// #endregion

// #region Ignore

model IgnoredModel {
  id String @id @default(uuid())

  @@ignore
}

model ModelWithIgnoredField {
  id              String @id @default(uuid())
  shouldBeIgnored String @ignore
}

// #endregion

// #region Default
// start -sqlite
enum EnumForDefault {
  TypeOne
  TypeTwo
}

// end -sqlite

model Default {
  id        String    @id
  /// drizzle.default @paralleldrive/cuid2::createId
  alsoId    String?
  /// drizzle.default crypto::randomBytes `() => randomBytes(16).toString('hex')`
  salt      String?
  pgUuid    String?   @default(dbgenerated("gen_random_uuid()")) // -sqlite -mysql
  date      DateTime? @default("2024-01-23T00:00:00Z")
  int       Int?      @default(1)
  boolean   Boolean?  @default(true)
  createdAt DateTime? @default(now())
  string    String?   @default("John")
  bigint    BigInt?   @default(1)
  decimal   Decimal?  @default(1.123)
  float     Float?    @default(1.123)
  bytes     Bytes?    @default("aGVsbG8gd29ybGQ=")

  enum EnumForDefault @default(TypeTwo) // -sqlite
  json Json?          @default("{\"foo\": \"bar\"}") // -sqlite

  stringList String[] @default(["John", "Doe"]) // -sqlite -mysql
}

// start -sqlite
enum EnumWithMappedMember {
  Plain
  Mapped @map("db_mapped")
}

model EnumMappedDefault {
  id    String                 @id
  value EnumWithMappedMember   @default(Mapped)
  list  EnumWithMappedMember[] @default([Plain, Mapped]) // -mysql
}

// end -sqlite

model AutoIncrement {
  id  Int    @id @default(autoincrement())
  ref String @unique
}

model AutoIncrementBigInt {
  id  BigInt @id @default(autoincrement())
  ref String @unique
}

// #endregion

// #region UpdatedAt

model UpdatedAtModel {
  id        String   @id
  name      String?
  updatedAt DateTime @updatedAt
// start -sqlite
  /// drizzle.dateMode string
  updatedAtString DateTime @updatedAt
// end -sqlite
}

// #endregion

// #region Field

// start -sqlite
enum Enum {
  A
  B
}

// end -sqlite

model Field {
  id         String    @id
  string     String?
  boolean    Boolean?
  int        Int?
  bigint     BigInt?
  float      Float?
  decimal    Decimal?
  datetime   DateTime?
  stringList String[] // -mysql -sqlite
  bytes      Bytes?
  json       Json? // -sqlite
  enum       Enum? // -sqlite
}

// #endregion

// #region one to many
model OneToMany_One {
  id     String         @id
  manyId String
  many   OneToMany_Many @relation(fields: [manyId], references: [id])
}

model OneToMany_Many {
  id   String          @id
  ones OneToMany_One[]
}

// #endregion

// #region one to one
model OneToOne_A {
  id  String      @id
  b   OneToOne_B? @relation(fields: [bId], references: [id])
  bId String?     @unique
}

model OneToOne_B {
  id String      @id
  a  OneToOne_A?
  c  OneToOne_C?
}

model OneToOne_C {
  id  String     @id
  b   OneToOne_B @relation(fields: [bId], references: [id])
  bId String     @unique
}

// #endregion

// #region Disambiguating
model Disambiguating_Transfer {
  id          String               @id
  from        Disambiguating_User  @relation("Disambiguating_Transfer_from", fields: [fromId], references: [id])
  fromId      String
  to          Disambiguating_User  @relation("Disambiguating_Transfer_to", fields: [toId], references: [id])
  toId        String
  salePayment Disambiguating_Sale? @relation("Disambiguating_Sale_payment")
  saleTax     Disambiguating_Sale? @relation("Disambiguating_Sale_tax")
  createdAt   DateTime             @default(now())
}

model Disambiguating_User {
  id String @id

  receivedTransfers Disambiguating_Transfer[] @relation("Disambiguating_Transfer_to")
  sentTransfers     Disambiguating_Transfer[] @relation("Disambiguating_Transfer_from")
}

model Disambiguating_Sale {
  id        String                  @id
  payment   Disambiguating_Transfer @relation("Disambiguating_Sale_payment", fields: [paymentId], references: [id])
  paymentId String                  @unique
  tax       Disambiguating_Transfer @relation("Disambiguating_Sale_tax", fields: [taxId], references: [id])
  taxId     String                  @unique
}

// #endregion

// #region https://github.com/farreldarian/prisma-generator-drizzle/issues/55

model Disambiguating_Country {
  id         String                    @id @default(cuid())
  currencies Disambiguating_Currency[]
}

model Disambiguating_Currency {
  code      String                   @id @unique
  countries Disambiguating_Country[]
}

// #endregion

// #region Native types
// Lines prefixed with `// +mysql ` are only uncommented in the mysql schema

// start -sqlite
model NativeType {
  id String @id

  date        DateTime @db.Date
  time        DateTime @db.Time
  timePrecise DateTime @db.Time(3)
  timestamp   DateTime @db.Timestamp(6)
  varchar     String   @db.VarChar(255)
  smallInt    Int      @db.SmallInt
  decimal     Decimal  @db.Decimal(10, 2)
  json        Json     @db.Json

  // MySQL rejects CURRENT_TIMESTAMP as the default of DATE and TIME columns, so Prisma can't create these
  dateNow     DateTime @default(now()) @db.Date // -mysql
  timeNow     DateTime @default(now()) @db.Time(2) // -mysql
  timestamptz DateTime @db.Timestamptz(6) // -mysql
  char        String   @db.Char(8) // -mysql
  uuid        String   @db.Uuid // -mysql
  inet        String   @db.Inet // -mysql
  real        Float    @db.Real // -mysql
  varcharList String[] @db.VarChar(255) // -mysql

  // +mysql datetime6     DateTime @db.DateTime(6)
  // +mysql unsignedInt   Int      @db.UnsignedInt
  // +mysql tinyInt       Int      @db.TinyInt
  // +mysql year          Int      @db.Year
  // +mysql mediumText    String   @db.MediumText
  // +mysql double        Float    @db.Double
}

// start -mysql
model UuidAuthor {
  id    String     @id @db.Uuid
  books UuidBook[]
}

model UuidBook {
  id      String       @id @db.Uuid
  authors UuidAuthor[]
}
// end -mysql

model VarcharAuthor {
  id    String        @id @db.VarChar(40)
  books VarcharBook[]
}

model VarcharBook {
  id      String          @id @db.VarChar(40)
  authors VarcharAuthor[]
}

// end -sqlite

// #region Foreign keys

// With @@map on the models and @map on the foreign key columns
model ForeignKey_Author {
  id       String               @id
  articles ForeignKey_Article[] @relation("ForeignKey_Article_author")
  reviews  ForeignKey_Article[] @relation("ForeignKey_Article_reviewer") // -sqlite

  @@map("fk_authors")
}

model ForeignKey_Article {
  id String @id

  // Explicit referential actions
  authorId String            @map("author_id")
  author   ForeignKey_Author @relation("ForeignKey_Article_author", fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // Optional with a named constraint (SQLite has no named foreign keys)
  reviewerId String?            @map("reviewer_id") // -sqlite
  reviewer   ForeignKey_Author? @relation("ForeignKey_Article_reviewer", fields: [reviewerId], references: [id], map: "fk_articles_reviewer_custom_fkey") // -sqlite

  @@map("fk_articles")
}

// Composite foreign key referencing a composite primary key
model ForeignKey_Region {
  country String
  code    String
  offices ForeignKey_Office[]

  @@id([country, code])
  @@map("fk_regions")
}

model ForeignKey_Office {
  id          String            @id
  countryCode String            @map("country_code")
  regionCode  String            @map("region_code")
  region      ForeignKey_Region @relation(fields: [countryCode, regionCode], references: [country, code])

  @@map("fk_offices")
}

// Optional composite foreign key referencing a composite unique
model ForeignKey_Warehouse {
  id      String             @id
  zone    String
  aisle   String
  shelves ForeignKey_Shelf[]

  @@unique([zone, aisle])
  @@map("fk_warehouses")
}

model ForeignKey_Shelf {
  id        String                @id
  zone      String?
  aisle     String?
  warehouse ForeignKey_Warehouse? @relation(fields: [zone, aisle], references: [zone, aisle])

  @@map("fk_shelves")
}

// Single-column foreign keys pointing at each other: lazy callbacks across a module import cycle
model ForeignKey_Chicken {
  id      String             @id
  eggId   String?
  egg     ForeignKey_Egg?    @relation("ForeignKey_Chicken_egg", fields: [eggId], references: [id])
  layedBy ForeignKey_Egg[]   @relation("ForeignKey_Egg_chicken")

  @@map("fk_chickens")
}

model ForeignKey_Egg {
  id        String               @id
  chickenId String?
  chicken   ForeignKey_Chicken?  @relation("ForeignKey_Egg_chicken", fields: [chickenId], references: [id])
  hatchedBy ForeignKey_Chicken[] @relation("ForeignKey_Chicken_egg")

  @@map("fk_eggs")
}

// Composite foreign keys pointing at each other: the `foreignKey()` config callbacks reference each other
model ForeignKey_Host {
  a      String
  b      String
  guestA String?
  guestB String?
  guest  ForeignKey_Guest?  @relation("ForeignKey_Host_guest", fields: [guestA, guestB], references: [a, b])
  hosted ForeignKey_Guest[] @relation("ForeignKey_Guest_host")

  @@id([a, b])
  @@map("fk_hosts")
}

model ForeignKey_Guest {
  a     String
  b     String
  hostA String?
  hostB String?
  host  ForeignKey_Host?   @relation("ForeignKey_Guest_host", fields: [hostA, hostB], references: [a, b])
  hosts ForeignKey_Host[]  @relation("ForeignKey_Host_guest")

  @@id([a, b])
  @@map("fk_guests")
}

// Single-column target that is a @unique rather than the @id
model ForeignKey_Account {
  id       String               @id
  email    String               @unique
  sessions ForeignKey_Session[]

  @@map("fk_accounts")
}

model ForeignKey_Session {
  id           String             @id
  accountEmail String             @map("account_email")
  account      ForeignKey_Account @relation(fields: [accountEmail], references: [email])

  @@map("fk_sessions")
}

// The default constraint name is longer than the identifier limit, so Prisma truncates it
model ForeignKey_LongOwner {
  id    String                @id
  names ForeignKey_LongName[]

  @@map("fk_long_owners")
}

model ForeignKey_LongName {
  id      String               @id
  ownerId String               @map("owner_column_with_a_long_name")
  owner   ForeignKey_LongOwner @relation(fields: [ownerId], references: [id])

  @@map("fk_a_rather_long_table_name_for_truncation")
}

// #endregion

model FieldCustomization {
  id        Int    @id @default(autoincrement())
  /// drizzle.custom {
  ///   "imports": [{ "name": ["SomeBigInt"], "module": "~/tests/shared/testFieldCustomization", "type": true }],
  ///   "$type": "SomeBigInt",
  ///   "default": "() => 1n",
  ///   "field": { "mode": "number" }
  /// }
  allFields BigInt
}
